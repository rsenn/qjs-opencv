    import * as cv from 'opencv';
    let clahe = cv.createCLAHE(2.0, new cv.Size(4, 4));
    // clahe.clipLimit === 2, [...clahe.tilesGridSize] == [4, 4] - was TypeError before

- FIXED: no-camshift-meanshift-bindings: `cv.CamShift`/`cv.meanShift` -
  registered in opencv.js's `core_bindings.cpp`, returning `[RotatedRect,
  updatedRect]` and `[n, updatedRect]` respectively - had no binding
  anywhere in the tree; only the unrelated `pyrMeanShiftFiltering`
  existed. Ported tracking code calling either threw `TypeError: cv.
  CamShift is not a function`. Fixed by adding `js_imgproc_track`
  (`js_imgproc.cpp`, magic dispatch `TRACK_CAMSHIFT`/`TRACK_MEANSHIFT`)
  wrapping `cv::CamShift`/`cv::meanShift`: takes `(probImage, window,
  criteria)`, mutates the passed-in `Rect` in place (matches native
  OpenCV's in/out `window` semantics) and also returns the updated `Rect`
  as the second array element (matches opencv.js's return shape).
  `criteria` reuses this project's existing `kmeans` convention - a plain
  `[type, maxCount, epsilon]` array - rather than a `TermCriteria` object,
  since no `TermCriteria` JS class exists anywhere in the codebase yet
  (tracked separately, see TODO.md's `kmeans` entry). Verified both
  functions converge a window toward a synthetic bright blob and mutate
  the input `Rect`.

    import * as cv from 'opencv';
    let img = new cv.Mat(100, 100, cv.CV_8UC1, new Uint8Array(100 * 100));
    for(let y = 30; y < 70; y++)
      for(let x = 30; x < 70; x++)
        img.data[y * 100 + x] = 200;
    let window = new cv.Rect(20, 20, 50, 50);
    let [rr, updated] = cv.CamShift(img, window, [cv.TERM_CRITERIA_EPS + cv.TERM_CRITERIA_COUNT, 10, 1]);
    // rr is a RotatedRect centered near (50,50); updated/window both moved toward the blob - was TypeError before

- FIXED: feature2d-detectors-no-create-static: `ORB`/`MSER`/`AKAZE`/
  `BRISK`/`FastFeatureDetector`/`GFTTDetector` (`js_feature2d.cpp`) were
  registered as `new`-constructible classes only - their static-func
  tables held only enum constants (e.g. `ORB.HARRIS_SCORE`), or for
  `BRISK`/`MSER`/`GFTTDetector`, no static-func table at all. opencv.js's
  whitelist exposes *only* `XXX.create(...)` for all of these, no public
  constructor. Ported code calling e.g. `cv.ORB.create(...)` threw
  `TypeError: cv.ORB.create is not a function`. Fixed by adding a
  `create` entry to each class's static-func table that points directly
  at the same function already used as the `new`-constructor body
  (`js_feature2d_orb`, `js_feature2d_mser`, etc.) - none of them read
  their `new_target` argument, so the identical function correctly
  serves both call forms. `new cv.ORB(...)` etc. still work unchanged.
  Also discovered in passing (not fixed, out of scope): `new cv.BRISK()`
  /`cv.BRISK.create()` with zero arguments throws `InternalError:
  BRISK::create([thresh, octaves,] radiusList, numberList, dMax, dMin,
  indexChange)` - none of `js_feature2d_brisk`'s three argument-count
  branches accept `argc === 0`, even though native `BRISK::create()` has
  all-defaulted parameters and opencv.js's `BRISK.create()` works with no
  arguments. Pre-existing, not introduced by this fix.

    import * as cv from 'opencv';
    let orb = cv.ORB.create(300);
    let kps = [];
    orb.detect(new cv.Mat(64, 64, cv.CV_8UC1, new Uint8Array(64 * 64)), kps);
    // works - was TypeError: cv.ORB.create is not a function before

    // separately-discovered, still open:
    new cv.BRISK();
    // InternalError: BRISK::create([thresh, octaves,] radiusList, numberList, dMax, dMin, indexChange)

- FIXED: minmaxloc-positional-array-not-named-object: `cv.minMaxLoc()`

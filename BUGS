    ../scan.js, ../doc-scanner.js, ../test-diagram.js, ../test-video.js
    ../test-opencv.js, ../test-cli.js, ../plot-cv.js
    ../test.js, ../test-umat.js, ../test-quickjs.js, ../test-imread.js

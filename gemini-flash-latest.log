    ${OPENCV_EXTRA_LIBRARIES}
    ${OPENCV_LIBRARIES})
  
  if(USE_LIBCAMERA OR USE_LCCV)
    list(APPEND jsbindings_LIBRARIES ${pkgcfg_lib_LIBCAMERA_camera})
  endif(USE_LIBCAMERA OR USE_LCCV)
  
  #dump(LCCV_LIBRARY_DIR)

  #make_module(opencv init_module.cpp)
  
  list(APPEND jsbindings_LINK_DIRECTORIES ${OPENCV_LIBDIR})
  list(
    APPEND
    jsbindings_LIBRARIES
    ${QUICKJS_LIBRARY}
    ${PNG_LIBRARIES}
    ${OPENCV_XIMGPROC_LIBRARY}
